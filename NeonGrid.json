{
  "blocks": [
    {
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "background": "#1e1e2e",
          "foreground": "#a6adc8",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ if ne .Env.POSH_SESSION_DEFAULT_USER .UserName }}<#89b4fa>{{ .UserName }}</> {{ end }}",
          "type": "session"
        },
        {
          "background": "#1e1e2e",
          "foreground": "#cdd6f4",
          "powerline_symbol": "\ue0b1",
          "options": {
            "folder_icon": "<#a6adc8>\ue5fe </>",
            "folder_separator_icon": "<#6c7086> \ue0b1 </>",
            "home_icon": "\uf015",
            "style": "agnoster_short"
          },
          "style": "powerline",
          "template": "<#89b4fa>\ue5ff </> {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#1e1e2e",
          "foreground": "#f9e2af",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f9e2af{{ end }}",
            "{{ if gt .Ahead 0 }}#89dceb{{ end }}",
            "{{ if gt .Behind 0 }}#cba6f7{{ end }}"
          ],
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "powerline_symbol": "\ue0b1",
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }}<#f38ba8> \uf044 {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#a6e3a1> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#1e1e2e",
          "foreground": "#89b4fa",
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "template": " \u276f ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{ .Shell }} \u2014 {{ .Folder }}",
  "final_space": true,
  "version": 4
}
